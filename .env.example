# ============================================
# ОБЩИЕ НАСТРОЙКИ
# ============================================
NODE_ENV=development
APP_NAME=TradeMaster AI TJ Bot
APP_URL=https://your-domain.tj
PORT=3000
HEALTH_PORT=3001
TIMEZONE=Asia/Dushanbe

# ============================================
# TELEGRAM BOT
# ============================================
BOT_TOKEN=                          # Получить у @BotFather
ADMIN_CONTACT_USERNAME=             # Telegram username админа/поддержки (без @) для кнопки "Связаться с администратором"
BOT_WEBHOOK_DOMAIN=                 # Домен для webhook (если не polling)
BOT_WEBHOOK_PATH=/telegraf/webhook
BOT_USE_WEBHOOK=false               # true = webhook, false = long polling
ADMIN_TELEGRAM_IDS=123456789        # ID через запятую

# ============================================
# MONGODB
# ============================================
MONGO_URI=mongodb://localhost:27017/trademaster_ai_tj
MONGO_VECTOR_INDEX=vector_index

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT / АДМИН-ПАНЕЛЬ
# ============================================
JWT_SECRET=change_me_super_secret_key
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_me_session_secret
ADMIN_DEFAULT_LOGIN=admin
ADMIN_DEFAULT_PASSWORD=change_me_on_first_login

# ============================================
# 🤖 GROQ AI (ОСНОВНОЙ, БЕСПЛАТНЫЙ)
# Получить ключ: https://console.groq.com
# ============================================
GROQ_API_KEY=
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_VISION=llama-3.2-11b-vision-preview
GROQ_MODEL_WHISPER=whisper-large-v3
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.7
GROQ_RATE_LIMIT_RPM=30
GROQ_RATE_LIMIT_RPD=14400

# ============================================
# 🤖 FALLBACK AI-ПРОВАЙДЕРЫ (БЕСПЛАТНЫЕ)
# ============================================
OPENROUTER_API_KEY=                 # https://openrouter.ai
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

GOOGLE_GEMINI_API_KEY=              # https://aistudio.google.com
GOOGLE_GEMINI_MODEL=gemini-1.5-flash

TOGETHER_API_KEY=                   # https://api.together.ai
TOGETHER_MODEL=meta-llama/Llama-3-8b-chat-hf

# ============================================
# 🔢 ЭМБЕДДИНГИ (RAG)
# ============================================
COHERE_API_KEY=                     # https://cohere.com (бесплатный тариф)
COHERE_EMBED_MODEL=embed-multilingual-v3.0
EMBEDDING_DIMENSIONS=1024

# ============================================
# 💹 ДАННЫЕ РЫНКА
# ============================================
COINGECKO_API_URL=https://api.coingecko.com/api/v3
BINANCE_API_URL=https://api.binance.com

# ============================================
# 💳 ПЛАТЁЖНЫЕ СИСТЕМЫ ТАДЖИКИСТАНА
# ============================================
ALIF_MERCHANT_ID=
ALIF_API_KEY=
ALIF_API_URL=https://web.alif.tj/api

ESKHATA_MERCHANT_ID=
ESKHATA_API_KEY=
ESKHATA_API_URL=

HUMO_MERCHANT_ID=
HUMO_API_KEY=

NOWPAYMENTS_API_KEY=                # https://nowpayments.io (крипто)
NOWPAYMENTS_IPN_SECRET=

MANUAL_PAYMENT_CARD=                # Номер карты для ручной оплаты

# ============================================
# ЦЕНЫ ПОДПИСОК (в сомони, TJS)
# ============================================
PRICE_SILVER=299
PRICE_GOLD=599
PRICE_DIAMOND=999

# ============================================
# ЛОГИРОВАНИЕ
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs
